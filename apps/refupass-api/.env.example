DATABASE_URL=sqlite:///./refupass.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Main identity verification path
ESIGNET_UI_URL=http://localhost:3000
ESIGNET_API_URL=http://localhost:8088
ESIGNET_CALLBACK_URL=http://127.0.0.1:8000/platform/identity/esignet/callback
ESIGNET_CLIENT_NAME=RefuPass Platform Verification
ESIGNET_CLIENT_LOGO_URL=https://example.com/refupass-logo.png

# Optional experimental Inji Verify settings. These are not required for the
# current RefuPass-native pass flow, but remain for research/integration work.
INJI_VERIFY_MODE=passthrough
INJI_VERIFY_API_URL=http://localhost:18080/v1/verify
INJI_WEB_URL=http://localhost:3001
INJI_VERIFY_UI_URL=http://localhost:13000

DEMO_BENEFICIARY_SUBJECT=5860356276
PASS_SIGNING_SECRET=refupass-demo-pass-signing-secret
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin123
PLATFORM_ADMIN_DISPLAY_NAME=RefuPass Platform Admin
JWT_ACCESS_SECRET_KEY=refupass-dev-access-secret-change-me
JWT_REFRESH_SECRET_KEY=refupass-dev-refresh-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14
JWT_ISSUER=refupass-api
